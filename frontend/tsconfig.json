{
  "files": [],
  // Duplicated from tsconfig.app.json: the shadcn CLI reads path aliases from
  // this file, and project references hide them from it otherwise.
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ]
}

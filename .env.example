# ─────────────────────────────────────────────────────────────────────────────
# ScoreGrid — local environment
# Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Shared JWT signing secret (HS256). Minimum 32 bytes.
# Generate one:  openssl rand -base64 48
SCOREGRID_JWT_SECRET=REPLACE_ME_WITH_openssl_rand_base64_48
SCOREGRID_JWT_TTL=PT24H
SCOREGRID_JWT_ISSUER=scoregrid-auth

# Initial Auth administrator. The account is created automatically on the first
# auth-service startup. Replace the placeholder; it is not a usable password.
SCOREGRID_ADMIN_USERNAME=admin
SCOREGRID_ADMIN_EMAIL=admin@scoregrid.local
SCOREGRID_ADMIN_PASSWORD=REPLACE_ME_WITH_a_password_of_at_least_8_characters

# ─────────────────────────────────────────────────────────────────────────────
# Databases
#
# One Postgres instance and one MongoDB instance, each holding one database per
# service with its own login. The root credentials below provision those roles
# on first startup and are never used by a service.
#
# Changing any database name, user or password after the first start has no
# effect: the init scripts only run on an empty volume. Re-provision with
#   docker compose down -v
# which also deletes all local data.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres: instance superuser (provisioning only) ─────────────────────────
POSTGRES_ROOT_USER=scoregrid
POSTGRES_ROOT_PASSWORD=scoregrid

# ── Auth database ────────────────────────────────────────────────────────────
POSTGRES_AUTH_DB=scoregrid_auth
POSTGRES_AUTH_USER=auth_service
POSTGRES_AUTH_PASSWORD=scoregrid

# ── Tournament database ──────────────────────────────────────────────────────
POSTGRES_TOURNAMENT_DB=scoregrid_tournament
POSTGRES_TOURNAMENT_USER=tournament_service
POSTGRES_TOURNAMENT_PASSWORD=scoregrid

# ── MongoDB: instance root user (provisioning only) ──────────────────────────
# Setting these switches mongod into authenticated mode.
MONGO_ROOT_USER=scoregrid
MONGO_ROOT_PASSWORD=scoregrid

# ── Prediction database ──────────────────────────────────────────────────────
MONGO_PREDICTION_DB=scoregrid_prediction
MONGO_PREDICTION_USER=prediction_service
# Avoid : / ? # @ here — the password goes into a mongodb:// URI unencoded.
MONGO_PREDICTION_PASSWORD=scoregrid

# ── Score database ───────────────────────────────────────────────────────────
MONGO_SCORE_DB=scoregrid_score
MONGO_SCORE_USER=score_service
MONGO_SCORE_PASSWORD=scoregrid

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=scoregrid
RABBITMQ_PASSWORD=scoregrid

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000

# ── External results provider (Stream B, feature-flagged off) ────────────────
RESULTS_PROVIDER_ENABLED=false
RESULTS_PROVIDER_BASE_URL=
RESULTS_PROVIDER_API_KEY=

# ── Observability (profile: observability) ───────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
